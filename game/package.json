{
  "name": "dwu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "predev": "node scripts/gen-asset-manifest.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/gen-asset-manifest.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import-assets": "bash scripts/import-assets.sh",
    "desktop:dev": "npm run build && electron desktop/main.cjs",
    "package:linux": "electron-packager . dwu --platform=linux --arch=x64 --out=release --overwrite --app-version=0.1.0 --electron-version=44.4.5 --no-prune",
    "package:mac": "electron-packager . dwu --platform=darwin --arch=arm64 --out=release --overwrite --app-version=0.1.0 --electron-version=44.4.5 --no-prune"
  },
  "dependencies": {
    "pixi.js": "^8.21.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.2",
    "electron": "^44.4.5",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
